PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smssender

# Beephub SMS API v2
BEEPHUB_API_KEY=
BEEPHUB_BASE_URL=https://sms-api.beephub.ge
DEFAULT_SENDER=BEEPHUB
# 1 = არ აგზავნის რეალურად, ახდენს პროვაიდერის იმიტაციას (ტესტირებისთვის)
BEEPHUB_MOCK=1

# ცდები სულ (პირველი გაგზავნა + ხელახლა)
MAX_ATTEMPTS=3
# რამდენ წამში ერთხელ შეამოწმოს სტატუსი
POLL_INTERVAL_SEC=30
# ხელახალი ცდის პაუზები წამებში (ცდა 1->2, 2->3)
RETRY_DELAYS_SEC=60,300
TTL_SECONDS=3600
